{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "strict": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve", "skipLibCheck": true,
    "esModuleInterop": true, "isolatedModules": true, "resolveJsonModule": true, "allowJs": false,
    "baseUrl": ".", "paths": { "@/*": ["./*"] }, "plugins": [{ "name": "next" }]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
