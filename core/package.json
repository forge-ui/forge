{
  "name": "@forge-ui-official/core",
  "version": "0.1.6",
  "description": "Forge UI Kit — React 19 + Tailwind v4 components",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    },
    "./components/layouts/*": {
      "types": "./dist/components/layouts/*.d.ts",
      "import": "./dist/components/layouts/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prebuild": "node scripts/gen-assets.mjs",
    "build": "tsup && cp src/styles/tokens.css dist/styles.css",
    "test": "tsup test/*.test.tsx --no-config --format cjs --platform node --target node22 --out-dir tmp/core-tests --clean --external jsdom && node --test tmp/core-tests/*.test.cjs",
    "test:audit": "node --test scripts/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "update:package-api": "node scripts/update-package-api-snapshot.mjs",
    "audit:components": "node scripts/audit-components.mjs",
    "audit:components:showcase": "node scripts/audit-components.mjs --showcase",
    "predev": "node scripts/gen-assets.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "check": "pnpm typecheck && pnpm typecheck:test && pnpm lint && pnpm test && pnpm test:audit && pnpm audit:components",
    "preview": "pnpm --filter preview dev",
    "prepublishOnly": "pnpm check && pnpm build && pnpm check:package && pnpm check:consumer"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "solar-icon-set": "^2",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "solar-icon-set": "^2.0.1",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forge-ui/forge.git",
    "directory": "core"
  }
}
